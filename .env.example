# .env.example
# Copia este archivo como .env. No guardes aqui credenciales reales.
# Para Ollama local, configura JUDGMAN_MODEL=ollama/llama3 y la URL del servidor
# mediante la configuracion de LiteLLM de tu entorno.
JUDGMAN_API_KEY=replace-with-your-provider-api-key
JUDGMAN_MODEL=openai/gpt-4o-mini
JUDGMAN_WORKSPACE=.
JUDGMAN_MAX_FILE_BYTES=131072

# Preguntas sobre el sistema operativo (datos de solo lectura no sensibles).
JUDGMAN_ENABLE_SYSTEM_INFO=true
JUDGMAN_MAX_QUESTION_CHARS=2000
JUDGMAN_PATH_TOOLS_LIMIT=40

# Actualizaciones (la "ultima version" se lee del repo en GitHub).
# check_updates: comprueba al arrancar (cache 24h, sin bloquear).
# auto_update: reinstala sola si hay version nueva (opt-in, por defecto no).
JUDGMAN_CHECK_UPDATES=true
JUDGMAN_AUTO_UPDATE=false
